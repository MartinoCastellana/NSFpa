APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+psycopg://privacy:CHANGE_ME@postgres:5432/privacy
REDIS_URL=redis://redis:6379/0
STORAGE_ROOT=/srv/private/documents
MAX_UPLOAD_MB=25
MAX_PAGES=150
MAX_RASTER_PIXELS=40000000
OCR_ENGINE=tesseract
OCR_LANGUAGES=ita+eng
OCR_DPI=300
NER_MIN_CONFIDENCE=0.80
OCR_MIN_CONFIDENCE=0.70
REQUIRE_MANUAL_APPROVAL=true
FAIL_CLOSED=true
OPENAI_API_KEY=REPLACE_IN_LOCAL_ENV_ONLY
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODE=mock
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_OUTPUT_TOKENS=2500
DATA_ENCRYPTION_KEY=REPLACE_WITH_SECURE_KEY_FOR_DEV_ONLY
JWT_ISSUER=CHANGE_ME
JWT_AUDIENCE=nsfpa
OIDC_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
RETENTION_DAYS=30
MINICPM_OCR_ENABLED=false
# Esempio bridge locale: /Users/mimmolino/NSFpa/.venv/bin/python /Users/mimmolino/NSFpa/scripts/minicpm_ocr_runner.py
MINICPM_OCR_COMMAND=
MINICPM_OCR_PROJECT_ROOT=/Users/mimmolino/Desktop/MiniCPM-OCR
MINICPM_OCR_CLI=minicpmvocr
MINICPM_OCR_SERVER_URL=http://127.0.0.1:18499
MINICPM_OCR_MODEL=minicpm-ocr
MINICPM_OCR_TIMEOUT_SECONDS=900
MINICPM_OCR_LAYOUT_DEVICE=cpu
MINICPM_OCR_LAYOUT_MODEL=
MINICPM_OCR_WORK_ROOT=minicpm-runs
